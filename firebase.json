{
    "firestore": {
        "rules": "firestore.rules"
    },
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/**",
                "function": "api"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "redirects": [
            {
                "source": "/escola",
                "destination": "/dance",
                "type": 301
            },
            {
                "source": "/escola/",
                "destination": "/dance",
                "type": 301
            },
            {
                "source": "/company",
                "destination": "/dance/company",
                "type": 301
            },
            {
                "source": "/company/",
                "destination": "/dance/company",
                "type": 301
            }
        ]
    },
    "functions": {
        "source": "functions",
        "predeploy": [
            "npm --prefix \"$RESOURCE_DIR\" run build"
        ]
    }
}
